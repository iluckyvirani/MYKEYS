generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  SOLD
  RENTED
  MAINTENANCE
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  COTTAGE
  PENTHOUSE
  BUNGALOW
  CONDOMINIUM
  TOWNHOUSE
  STUDIO
}

enum ListingType {
  RENT
  BUY
}

enum RentalType {
  SHORT_TERM
  LONG_TERM
}

enum PriceType {
  NIGHTLY
  MONTHLY
  TOTAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  CHECKED_IN
  CHECKED_OUT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  CASH
  WALLET
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  CLOSED
  CONVERTED
}

enum PackageTier {
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  phone     String?    @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)

  // Personal Information (for USER role)
  birthDate String?
  
  // Address Information (for USER role)
  address String?
  city    String?
  state   String?
  country String?
  zipCode String?

  // Emergency Contact (for USER role)
  emergencyName    String?
  emergencyContact String?

  // Owner specific
  companyName String?
  taxId       String?
  website     String?

  // Relations
  properties      Property[]
  bookingsAsGuest Booking[]      @relation("GuestBookings")
  bookingsAsOwner Booking[]      @relation("OwnerBookings")
  inquiries       Inquiry[]
  reviews         Review[]
  notifications   Notification[]
  packages        OwnerPackage[]
  payments        Payment[]
  adCampaigns     AdCampaign[]
  reports         Report[]

  // Authentication
  resetToken       String?
  resetTokenExpiry DateTime?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?

  // Indexes
  @@index([email])
  @@index([role])
  @@index([status])
}

model Property {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?

  // Address
  address   String
  city      String
  state     String
  country   String  @default("India")
  zipCode   String?
  latitude  Float?
  longitude Float?

  // Property Details
  propertyType PropertyType
  listingType  ListingType
  rentalType   RentalType?

  // Pricing
  price           Float
  priceType       PriceType // nightly, monthly, total
  originalPrice   Float?
  cleaningFee     Float? @default(0)
  serviceFee      Float? @default(0)
  securityDeposit Float? @default(0)

  // Specifications
  bedrooms  Int
  bathrooms Int
  sqft      Int?
  guests    Int  @default(2)
  minStay   Int  @default(1)
  maxStay   Int?
  yearBuilt Int?
  parking   Int? @default(0)

  // Status & Visibility
  status        PropertyStatus @default(DRAFT)
  isFeatured    Boolean        @default(false)
  isVerified    Boolean        @default(false)
  featuredUntil DateTime?

  // Relations
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images    PropertyImage[]
  amenities PropertyAmenity[]
  bookings  Booking[]
  reviews   Review[]
  inquiries Inquiry[]
  adCampaigns AdCampaign[]

  // Analytics
  views      Int   @default(0)
  saves      Int   @default(0)
  occupancy  Int   @default(0) // percentage: 0-100
  revenue    Float @default(0) // monthly revenue for owner dashboard

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([ownerId])
  @@index([city])
  @@index([propertyType])
  @@index([status])
  @@index([isFeatured])
}

model PropertyImage {
  id        String  @id @default(cuid())
  url       String
  caption   String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId])
}

model Amenity {
  id       String  @id @default(cuid())
  name     String  @unique
  icon     String?
  category String

  properties PropertyAmenity[]

  createdAt DateTime @default(now())
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
}

model Booking {
  id String @id @default(cuid())

  // Booking Details
  checkIn  DateTime
  checkOut DateTime
  nights   Int
  guests   Int      @default(1)
  children Int?     @default(0)
  pets     Int?     @default(0)

  // Pricing
  basePrice     Float
  cleaningFee   Float?
  serviceFee    Float?
  totalAmount   Float
  paidAmount    Float  @default(0)
  balanceAmount Float  @default(0)

  // Status
  status        BookingStatus  @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?

  // Special Requests
  specialRequests String?
  notes           String?

  // Relations
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  guestId    String
  guest      User     @relation("GuestBookings", fields: [guestId], references: [id])
  ownerId    String?
  owner      User?    @relation("OwnerBookings", fields: [ownerId], references: [id])
  payment    Payment?
  review     Review?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  // Indexes
  @@index([propertyId])
  @@index([guestId])
  @@index([ownerId])
  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
}

model Payment {
  id                String        @id @default(cuid())
  amount            Float
  currency          String        @default("INR")
  paymentMethod     PaymentMethod
  status            PaymentStatus @default(PENDING)
  transactionId     String?       @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  // Relations
  bookingId String?       @unique
  booking   Booking?      @relation(fields: [bookingId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  packageId String?
  package   OwnerPackage? @relation("PackagePayment", fields: [packageId], references: [id])

  // Metadata
  metadata Json?

  // Timestamps
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ownerPackages OwnerPackage[] @relation("LastPayment")

  // Indexes
  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id       String  @id @default(cuid())
  rating   Int // Range: 1-5
  comment  String?
  response String?

  // Relations
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  bookingId  String?  @unique
  booking    Booking? @relation(fields: [bookingId], references: [id])

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?

  // Indexes
  @@index([propertyId])
  @@index([userId])
}

model Inquiry {
  id       String        @id @default(cuid())
  message  String
  status   InquiryStatus @default(NEW)
  priority String        @default("medium")
  type     String // short_term, long_term, purchase
  duration String?
  budget   Float?

  // Contact Info
  name  String
  email String
  phone String?

  // Relations
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  assignedTo String? // User ID of assigned staff

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?
  closedAt    DateTime?

  // Indexes
  @@index([propertyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id      String  @id @default(cuid())
  type    String // booking, inquiry, payment, system
  title   String
  message String
  isRead  Boolean @default(false)
  data    Json?

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Package {
  id          String      @id @default(cuid())
  name        String
  tier        PackageTier
  description String?

  // Pricing
  price    Float
  duration String // monthly, yearly
  isActive Boolean @default(true)

  // Features
  propertyLimit Int    @default(1)
  featuredLimit Int    @default(0)
  storageLimit  Int    @default(5) // in GB
  supportType   String @default("email")

  // Additional Features
  features Json // Array of feature objects

  // Timestamps
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ownerPackages OwnerPackage[]

  // Indexes
  @@index([tier])
  @@index([isActive])
}

model OwnerPackage {
  id String @id @default(cuid())

  // Subscription Details
  packageId String
  package   Package @relation(fields: [packageId], references: [id])
  ownerId   String
  owner     User    @relation(fields: [ownerId], references: [id])

  // Status
  status    SubscriptionStatus @default(ACTIVE)
  autoRenew Boolean            @default(true)

  // Dates
  startDate   DateTime
  endDate     DateTime
  nextBilling DateTime?
  cancelledAt DateTime?

  // Usage
  propertiesUsed Int   @default(0)
  featuredUsed   Int   @default(0)
  storageUsed    Float @default(0) // in GB

  // Payment
  lastPaymentId String?
  lastPayment   Payment? @relation("LastPayment", fields: [lastPaymentId], references: [id])
  payments      Payment[] @relation("PackagePayment")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([ownerId])
  @@index([packageId])
  @@index([status])
  @@index([endDate])
}

model AdCampaign {
  id       String @id @default(cuid())
  name     String
  platform String // facebook, instagram, google
  adType   String // image, video, carousel
  status   String // active, paused, completed

  // Budget
  budget      Float
  spent       Float  @default(0)
  dailyBudget Float?

  // Dates
  startDate DateTime
  endDate   DateTime

  // Targeting
  targetAudience Json? // JSON array of audience IDs
  locations      Json? // JSON array of locations

  // Performance
  impressions Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)

  // Relations
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([ownerId])
  @@index([propertyId])
  @@index([status])
  @@index([startDate])
}

model Report {
  id          String  @id @default(cuid())
  name        String
  type        String // performance, financial, property
  parameters  Json // Report filters and parameters
  generatedBy String // User ID
  fileUrl     String?
  fileSize    Int?
  downloads   Int     @default(0)

  // Relations
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes
  @@index([ownerId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id          String  @id @default(cuid())
  action      String // CREATE, UPDATE, DELETE
  entity      String // User, Property, Booking, etc.
  entityId    String
  changes     Json? // JSON diff of changes
  performedBy String // User ID
  ipAddress   String?
  userAgent   String?

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}
